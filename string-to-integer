#include <limits.h>

int myAtoi(char* s) {
    if (s == NULL) return 0;

    int i = 0;
    int sign = 1;
    long long result = 0;

    // 1. Ignore leading whitespace
    while (s[i] == ' ') {
        i++;
    }

    // 2. Determine signedness
    if (s[i] == '+' || s[i] == '-') {
        if (s[i] == '-') {
            sign = -1;
        }
        i++;
    }

    // 3. Conversion and 4. Rounding (Overflow check)
    while (s[i] >= '0' && s[i] <= '9') {
        result = result * 10 + (s[i] - '0');
        
        // Prevent overflow beyond 32-bit signed integer limits
        if (sign == 1 && result > INT_MAX) {
            return INT_MAX;
        }
        if (sign == -1 && -result < INT_MIN) {
            return INT_MIN;
        }
        
        i++;
    }

    return (int)(sign * result);
}

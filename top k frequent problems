#include <stdlib.h>

// Structure to pair each unique number with its frequency
typedef struct {
    int num;
    int freq;
} Element;

// Comparator function to sort Elements by frequency in descending order
int compare(const void* a, const void* b) {
    return ((Element*)b)->freq - ((Element*)a)->freq;
}

int* topKFrequent(int* nums, int numsSize, int k, int* returnSize) {
    // 1. Sort the initial array to easily group and count duplicates
    int intCompare(const void* a, const void* b) {
        return (*(int*)a - *(int*)b);
    }
    qsort(nums, numsSize, sizeof(int), intCompare);
    
    // 2. Count frequencies and store unique elements
    Element* elements = (Element*)malloc(numsSize * sizeof(Element));
    int uniqueCount = 0;
    
    for (int i = 0; i < numsSize; i++) {
        if (i > 0 && nums[i] == nums[i - 1]) {
            elements[uniqueCount - 1].freq++;
        } else {
            elements[uniqueCount].num = nums[i];
            elements[uniqueCount].freq = 1;
            uniqueCount++;
        }
    }
    
    // 3. Sort the unique elements by frequency (highest first)
    qsort(elements, uniqueCount, sizeof(Element), compare);
    
    // 4. Extract the top K elements into the result array
    int* result = (int*)malloc(k * sizeof(int));
    for (int i = 0; i < k; i++) {
        result[i] = elements[i].num;
    }
    
    // Free temporary storage and set the required return size pointer
    free(elements);
    *returnSize = k;
    return result;
}

#include <stdlib.h>
#include <string.h>

char* longestCommonPrefix(char** strs, int strsSize) {
    // If the input array is empty, return an empty string
    if (strsSize == 0) {
        char* empty = (char*)malloc(1 * sizeof(char));
        empty[0] = '\0';
        return empty;
    }
    
    // Take the first string as the initial reference prefix
    char* prefix = strs[0];
    int len = strlen(prefix);
    
    // Compare the prefix with every other string in the array
    for (int i = 1; i < strsSize; i++) {
        // Shorten the prefix length if the current string doesn't match it
        while (strncmp(prefix, strs[i], len) != 0) {
            len--;
            if (len == 0) {
                char* empty = (char*)malloc(1 * sizeof(char));
                empty[0] = '\0';
                return empty;
            }
        }
    }
    
    // Allocate exact memory for the final prefix string and copy it
    char* result = (char*)malloc((len + 1) * sizeof(char));
    strncpy(result, prefix, len);
    result[len] = '\0';
    
    return result;
}

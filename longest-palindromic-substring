#include <string.h>
#include <stdlib.h>

// Helper function to expand around a given center index
// Returns the length of the palindrome found
int expandAroundCenter(char* s, int left, int right, int length) {
    while (left >= 0 && right < length && s[left] == s[right]) {
        left--;
        right++;
    }
    // Return the length of the valid palindromic substring found
    return right - left - 1;
}

char* longestPalindrome(char* s) {
    if (s == NULL || strlen(s) < 1) {
        char* empty = (char*)malloc(sizeof(char));
        *empty = '\0';
        return empty;
    }

    int len = strlen(s);
    int start = 0;
    int maxLen = 0;

    for (int i = 0; i < len; i++) {
        // Check for odd-length palindromes (center is at index i)
        int len1 = expandAroundCenter(s, i, i, len);
        
        // Check for even-length palindromes (center is between i and i+1)
        int len2 = expandAroundCenter(s, i, i + 1, len);
        
        // Find the maximum of both expansions
        int currentMax = (len1 > len2) ? len1 : len2;

        // If a longer palindrome is found, update the boundaries
        if (currentMax > maxLen) {
            maxLen = currentMax;
            start = i - (currentMax - 1) / 2;
        }
    }

    // Allocate memory for the result string (+1 for null terminator)
    char* result = (char*)malloc((maxLen + 1) * sizeof(char));
    strncpy(result, s + start, maxLen);
    result[maxLen] = '\0'; // Null-terminate the string

    return result;
}

#include <stdlib.h>

// Helper comparison function for qsort
int compare(const void *a, const void *b) {
    return (*(int*)a - *(int*)b);
}

int* intersect(int* nums1, int nums1Size, int* nums2, int nums2Size, int* returnSize) {
    // 1. Sort both arrays
    qsort(nums1, nums1Size, sizeof(int), compare);
    qsort(nums2, nums2Size, sizeof(int), compare);
    
    // Allocate space for the result array (at most the size of the smaller array)
    int maxSize = nums1Size < nums2Size ? nums1Size : nums2Size;
    int* result = (int*)malloc(maxSize * sizeof(int));
    
    int i = 0, j = 0, k = 0;
    
    // 2. Use two pointers to find common elements
    while (i < nums1Size && j < nums2Size) {
        if (nums1[i] < nums2[j]) {
            i++;
        } else if (nums1[i] > nums2[j]) {
            j++;
        } else {
            result[k++] = nums1[i];
            i++;
            j++;
        }
    }
    
    // 3. Set the final size of the result array
    *returnSize = k;
    return result;
}

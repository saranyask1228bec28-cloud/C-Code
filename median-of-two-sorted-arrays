#define MAX(a, b) ((a) > (b) ? (a) : (b))
#define MIN(a, b) ((a) < (b) ? (a) : (b))

double findMedianSortedArrays(int* nums1, int nums1Size, int* nums2, int nums2Size) {
    // Ensure nums1 is the smaller array to optimize binary search runtime to O(log(min(m, n)))
    if (nums1Size > nums2Size) {
        return findMedianSortedArrays(nums2, nums2Size, nums1, nums1Size);
    }
    
    int m = nums1Size;
    int n = nums2Size;
    int low = 0;
    int high = m;
    
    while (low <= high) {
        int partition1 = (low + high) / 2;
        int partition2 = (m + n + 1) / 2 - partition1;
        
        // If partition1 is 0, nothing is on the left side of nums1. Use INT_MIN.
        // If partition1 is m, nothing is on the right side of nums1. Use INT_MAX.
        int maxLeft1 = (partition1 == 0) ? -2e9 : nums1[partition1 - 1];
        int minRight1 = (partition1 == m) ? 2e9 : nums1[partition1];
        
        int maxLeft2 = (partition2 == 0) ? -2e9 : nums2[partition2 - 1];
        int minRight2 = (partition2 == n) ? 2e9 : nums2[partition2];
        
        // Check if we found the correct partition
        if (maxLeft1 <= minRight2 && maxLeft2 <= minRight1) {
            // If total number of elements is odd
            if ((m + n) % 2 != 0) {
                return (double)MAX(maxLeft1, maxLeft2);
            }
            // If total number of elements is even
            return ((double)MAX(maxLeft1, maxLeft2) + MIN(minRight1, minRight2)) / 2.0;
        } 
        // We are too far right in nums1. Move left.
        else if (maxLeft1 > minRight2) {
            high = partition1 - 1;
        } 
        // We are too far left in nums1. Move right.
        else {
            low = partition1 + 1;
        }
    }
    
    return 0.0;
}

#include <stdbool.h>
#include <string.h>

bool isValid(char* s) {
    int len = strlen(s);
    // A stack to store opening brackets
    char stack[len];
    int top = -1;

    for (int i = 0; i < len; i++) {
        char ch = s[i];

        // Push opening brackets onto the stack
        if (ch == '(' || ch == '{' || ch == '[') {
            stack[++top] = ch;
        } 
        // Process closing brackets
        else {
            // If stack is empty or top doesn't match, it's invalid
            if (top == -1) return false;
            if (ch == ')' && stack[top] != '(') return false;
            if (ch == '}' && stack[top] != '{') return false;
            if (ch == ']' && stack[top] != '[') return false;
            
            // Pop the matching opening bracket
            top--;
        }
    }

    // If the stack is empty, all brackets were matched perfectly
    return top == -1;
}
